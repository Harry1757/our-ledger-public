LEDGER_STORAGE=firestore
GOOGLE_CLOUD_PROJECT=your-project-id
LEDGER_SETUP_CODE=replace-with-your-own-random-code-at-least-16-characters
PORT=8080

# Optional: separate signup code for App Review; expires at this Unix timestamp.
# Leave unset to disable. This creates new households and never logs into an existing household.
# LEDGER_REVIEW_SETUP_CODE=replace-with-a-random-code-at-least-16-characters
# LEDGER_REVIEW_SETUP_EXPIRES=unix-expiration-seconds
